# Copy this file to ".env" and fill in what you want. Everything here is optional.

# Lets the Title Writer use Claude to write titles, captions and a virality score.
# Without it, titles come from built-in templates.
ANTHROPIC_API_KEY=

# Lets the Calendar Analyst read a Twitch streamer's official published schedule.
# Create an app at https://dev.twitch.tv/console/apps to get these.
# Without them, the calendar is learned from the streamer's past broadcasts.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Port for the dashboard (default 8765)
PORT=
